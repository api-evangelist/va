        {
          "info": {
            "name": "/v2/prescriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.va.gov/services/appeals/appealable-issues/{version}/v2/prescriptions",
            "headers": [
              {
                "name": "X-Key-Inflection",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "filter[disp_status][eq]",
                "value": "",
