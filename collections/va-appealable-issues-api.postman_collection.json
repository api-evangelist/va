                  "disabled": false,
                  "key": "benefitType",
                  "value": "<string>",
                  "description": "Required if decision review type is Higher-Level Reviews or Supplemental Claims"
                },
                {
                  "disabled": false,
                  "key": "receiptDate",
                  "value": "<date>",
                  "description": "(Required) (yyyy-mm-dd) In order to determine appealability of issues, the receipt date of a hypothetical Decision Review must be specified."
                },
                {
                  "disabled": false,
                  "key": "icn",
