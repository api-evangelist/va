          "name": "Returns all appealable issues for a specific Veteran.",
          "request": {
            "name": "Returns all appealable issues for a specific Veteran.",
            "description": {
              "content": "Returns all issues associated with a Veteran that have been decided as of the `receiptDate`. Not all issues returned are guaranteed to be eligible for appeal.",
              "type": "text/plain"
            },
